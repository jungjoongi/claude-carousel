#!/usr/bin/env bash
# claude-carousel — switch between multiple Claude Code accounts,
# with automatic rotation when one hits a usage/rate limit.
#
# https://github.com/jungjoongi/claude-carousel
#
# How it works: Claude Code reads CLAUDE_CONFIG_DIR to decide where its
# config/session state lives, and (on macOS) which system-keychain slot to
# use for OAuth tokens. Pointing that env var at a different directory per
# "profile" gives each profile its own login, with zero extra bookkeeping —
# Claude Code's own /login flow manages credentials however the OS normally
# does (keychain on macOS, a local file on Linux).
#
# Written in bash 3.2-compatible syntax on purpose: that's still the
# default /bin/bash on macOS, and this script targets it directly rather
# than requiring Homebrew bash or zsh.

set -u

VERSION="0.4.0"

DEFAULT_DIR="$HOME/.claude"
CAROUSEL_HOME="${CAROUSEL_HOME:-$HOME/.claude-carousel}"
PROFILE_ROOT="$CAROUSEL_HOME/profiles"
DEFAULT_FILE="$CAROUSEL_HOME/default"
ORDER_FILE="$CAROUSEL_HOME/order"
CLAUDE_BIN="${CAROUSEL_CLAUDE_BIN:-claude}"
OS="$(uname -s)"

# Bypass mode: every run gets --dangerously-skip-permissions, which is what
# most people juggling several accounts actually want. It is documented in the
# README as on-by-default. Turn it off for a session or for good with:
#   export CAROUSEL_BYPASS=0
BYPASS="${CAROUSEL_BYPASS:-1}"

# What `carousel go` sends after switching accounts, so the turn a usage limit
# cut off carries on by itself. Set it empty to resume the conversation and
# wait at the prompt instead:
#   export CAROUSEL_RESUME_PROMPT=
RESUME_PROMPT="${CAROUSEL_RESUME_PROMPT-You were cut off by a usage limit. Continue where you left off.}"

RESERVED_CMDS="ls list add login use switch whoami who sync rm remove order go doctor alias star update version help"

REPO_SLUG="jungjoongi/claude-carousel"
ALIAS_FILE="$CAROUSEL_HOME/alias"

# Self-update. carousel is a single file fetched from raw.githubusercontent, so
# updating is "download it again and rename it into place". The check runs at
# most once a day, only on the paths that launch Claude Code, and only when
# there is a terminal to report to.
#   CAROUSEL_NO_UPDATE=1        never check
#   CAROUSEL_UPDATE_INTERVAL=n  seconds between checks (default 86400)
#   CAROUSEL_UPDATE_URL=...     where to fetch from (override is for testing)
NO_UPDATE="${CAROUSEL_NO_UPDATE:-0}"
UPDATE_INTERVAL="${CAROUSEL_UPDATE_INTERVAL:-86400}"
UPDATE_URL="${CAROUSEL_UPDATE_URL:-https://raw.githubusercontent.com/$REPO_SLUG/main/bin/carousel}"
UPDATE_STAMP="$CAROUSEL_HOME/last-update-check"
BLOCK_START="# >>> claude-carousel alias >>>"
BLOCK_END="# <<< claude-carousel alias <<<"

if [ -t 1 ]; then
  C_B=$'\033[1m'; C_D=$'\033[2m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_0=$'\033[0m'
else
  C_B=''; C_D=''; C_G=''; C_Y=''; C_R=''; C_0=''
fi

die()  { printf '%serror:%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }
warn() { printf '%swarning:%s %s\n' "$C_Y" "$C_0" "$*" >&2; }

prompt_read() {
  # echoes one line of user input. Prefers the real terminal so prompts still
  # work under `curl … | bash`, and falls back to stdin when there's no tty.
  local ans=""
  if { : < /dev/tty; } 2>/dev/null; then
    read -r ans < /dev/tty || true
  else
    read -r ans || true
  fi
  printf '%s\n' "$ans"
}

is_reserved() {
  local w
  for w in $RESERVED_CMDS; do [ "$w" = "$1" ] && return 0; done
  return 1
}

abspath() {
  # portable stand-in for zsh's ${var:A} / GNU readlink -f
  if [ -d "$1" ]; then (cd "$1" 2>/dev/null && pwd -P)
  else printf '%s\n' "$1"
  fi
}

profile_dir() {
  if [ "$1" = "default" ]; then printf '%s\n' "$DEFAULT_DIR"
  else printf '%s\n' "$PROFILE_ROOT/$1"
  fi
}

profile_exists() {
  [ "$1" = "default" ] && return 0
  [ -d "$PROFILE_ROOT/$1" ]
}

list_profiles() {
  printf '%s\n' default
  [ -d "$PROFILE_ROOT" ] || return 0
  local d
  for d in "$PROFILE_ROOT"/*/; do
    [ -d "$d" ] || continue
    basename "$d"
  done
}

get_default() {
  if [ -f "$DEFAULT_FILE" ]; then
    local n; n=$(cat "$DEFAULT_FILE" 2>/dev/null | tr -d '[:space:]')
    if [ -n "$n" ] && profile_exists "$n"; then printf '%s\n' "$n"; return; fi
  fi
  printf '%s\n' default
}

get_order() {
  if [ -f "$ORDER_FILE" ]; then
    cat "$ORDER_FILE"
  else
    list_profiles
  fi
}

config_json() {
  local dir="$1"
  if [ "$(abspath "$dir")" = "$(abspath "$DEFAULT_DIR")" ]; then
    printf '%s\n' "$HOME/.claude.json"
  else
    printf '%s\n' "$dir/.claude.json"
  fi
}

profile_email() {
  local cfg; cfg=$(config_json "$1")
  [ -f "$cfg" ] || { printf '%s\n' "-"; return; }
  python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print("-"); raise SystemExit
a = d.get("oauthAccount") or {}
print(a.get("emailAddress") or "(not logged in)")
' "$cfg" 2>/dev/null || printf '%s\n' "-"
}

# --- shared-asset sync ------------------------------------------------------
# Everything under ~/.claude that isn't account state is shared across profiles
# by symlink, so an edit made from any profile is the edit every profile sees.
#
# Files get the same treatment as directories on purpose. Claude Code rewrites
# settings.json whenever you touch /plugin, /config or an MCP server, so the
# copy this used to make was only ever authoritative until the next launch — at
# which point the shared copy quietly reverted whatever you had just changed,
# and a plugin you removed came back.
SHARED_DIRS="plugins skills projects"
SHARED_FILES="settings.json mcp.json CLAUDE.md"

# Deliberately not shared. settings.local.json is Claude Code's per-install
# override of settings.json, which makes it the one place a profile can differ —
# a different model, say — without forking the whole shared configuration. A new
# profile starts from a copy of the master's and owns it from then on.
LOCAL_FILES="settings.local.json"

BACKUP_ROOT="$CAROUSEL_HOME/backups"

backup_shared_file() {
  local name="$1" item="$2" src="$3"
  [ -f "$src" ] || return 0
  local dir="$BACKUP_ROOT/$name"
  mkdir -p "$dir" 2>/dev/null || return 0
  cp -p "$src" "$dir/$item.$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
}

# A profile holding a real file where a symlink belongs means one of two things:
# it predates this version of carousel, or a writer saved the file by renaming a
# temp file into place, which replaces the link instead of following it. The
# second case carries edits the shared copy has never seen, so decide by mtime
# rather than throwing the file away.
reclaim_shared_file() {
  local name="$1" item="$2" target="$3" master="$4"

  cmp -s "$target" "$master" 2>/dev/null && return 0

  # Only a strictly newer master wins. Ties go to the profile on purpose: mtime
  # here is second-resolution, so two edits in the same second are
  # indistinguishable, and the profile differing at all is evidence something
  # wrote to it. Losing that edit is the bug this whole function exists to fix,
  # and the master is backed up before it is replaced either way.
  if [ -f "$master" ] && [ "$master" -nt "$target" ]; then
    backup_shared_file "$name" "$item" "$target"
    return 0
  fi

  backup_shared_file "$name" "$item" "$master"
  cp -p "$target" "$master"
  warn "$name/$item was newer than the shared copy — promoted it to $DEFAULT_DIR/$item"
}

sync_profile() {
  local name="$1" dir; dir=$(profile_dir "$name")
  [ "$name" = "default" ] && return 0
  [ -d "$dir" ] || die "profile '$name' does not exist. Run: carousel add $name"

  local item target master
  for item in $SHARED_DIRS; do
    [ -e "$DEFAULT_DIR/$item" ] || continue
    target="$dir/$item"
    if [ -L "$target" ]; then
      [ "$(readlink "$target")" = "$DEFAULT_DIR/$item" ] && continue
      rm -f "$target"
    elif [ -e "$target" ]; then
      warn "$name/$item is a real directory (not a symlink) — leaving it alone"
      continue
    fi
    ln -sfn "$DEFAULT_DIR/$item" "$target"
  done

  for item in $SHARED_FILES; do
    target="$dir/$item"
    master="$DEFAULT_DIR/$item"
    if [ -L "$target" ]; then
      [ "$(readlink "$target")" = "$master" ] && continue
      rm -f "$target"
    elif [ -f "$target" ]; then
      reclaim_shared_file "$name" "$item" "$target" "$master"
      rm -f "$target"
    fi
    # Nothing to point at yet. Leave it absent rather than dangling, so the
    # first profile that creates the file gets it promoted on the next sync.
    [ -f "$master" ] || continue
    ln -sfn "$master" "$target"
  done

  # An older carousel shared these, so unpick any link it left behind and give
  # the profile back a file of its own to diverge in.
  for item in $LOCAL_FILES; do
    target="$dir/$item"
    [ -L "$target" ] || continue
    master=$(readlink "$target")
    rm -f "$target"
    [ -f "$master" ] && cp -p "$master" "$target"
  done
}

seed_local_files() {
  local name="$1" dir; dir=$(profile_dir "$name")
  local item
  for item in $LOCAL_FILES; do
    [ -f "$DEFAULT_DIR/$item" ] || continue
    [ -e "$dir/$item" ] && continue
    cp -p "$DEFAULT_DIR/$item" "$dir/$item"
  done
}

# --- self-update ---------------------------------------------------------------
self_path() {
  case "$0" in
    /*)  printf '%s\n' "$0" ;;
    */*) printf '%s/%s\n' "$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)" "$(basename "$0")" ;;
    *)   command -v "$0" 2>/dev/null || printf '%s\n' "$0" ;;
  esac
}

version_gt() {
  # $1 > $2 as a dotted numeric version. Pure bash so it works with BSD tools,
  # where `sort -V` can't be relied on.
  local a="$1" b="$2" x y
  while [ -n "$a" ] || [ -n "$b" ]; do
    x="${a%%.*}"; y="${b%%.*}"
    case "$a" in *.*) a="${a#*.}" ;; *) a="" ;; esac
    case "$b" in *.*) b="${b#*.}" ;; *) b="" ;; esac
    x=$(printf '%s' "${x:-0}" | tr -cd '0-9'); [ -n "$x" ] || x=0
    y=$(printf '%s' "${y:-0}" | tr -cd '0-9'); [ -n "$y" ] || y=0
    [ "$x" -gt "$y" ] && return 0
    [ "$x" -lt "$y" ] && return 1
  done
  return 1
}

update_blocked_reason() {
  # prints why a self-update can't happen, or nothing at all if it can
  local self="$1"
  [ "$NO_UPDATE" = "1" ]                  && { printf 'disabled by CAROUSEL_NO_UPDATE\n'; return; }
  [ -n "${CAROUSEL_UPDATED:-}" ]          && { printf 'already updated in this run\n'; return; }
  command -v curl >/dev/null 2>&1         || { printf 'curl not found\n'; return; }
  [ -f "$self" ]                          || { printf "can't locate the carousel script\n"; return; }
  [ -L "$self" ]                          && { printf 'installed as a symlink — update whatever it points at\n'; return; }
  [ -w "$self" ]                          || { printf '%s is not writable\n' "$self"; return; }
  [ -w "$(dirname "$self")" ]             || { printf '%s is not writable\n' "$(dirname "$self")"; return; }
  if (cd "$(dirname "$self")" 2>/dev/null && git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
    printf 'running from a git checkout — use git pull instead\n'; return
  fi
  return 0
}

remote_version() {
  local v
  v=$(sed -n 's/^VERSION="\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n 1)
  [ -n "$v" ] || return 1
  printf '%s\n' "$v"
}

fetch_update() {
  # downloads the latest script next to $1 and echoes the temp path, or nothing.
  # The temp file is a sibling so the later mv stays on one filesystem and is
  # therefore atomic: the running shell keeps reading the old inode either way.
  local self="$1" tmp
  tmp=$(mktemp "$self.XXXXXX" 2>/dev/null) || return 1
  if ! curl -fsSL --max-time "${CAROUSEL_UPDATE_TIMEOUT:-2}" "$UPDATE_URL" -o "$tmp" 2>/dev/null; then
    rm -f "$tmp"; return 1
  fi
  # Refuse anything that isn't a syntactically valid carousel: a captive-portal
  # login page or a truncated download must never land on the user's PATH.
  case "$(head -n 1 "$tmp")" in
    '#!'*bash*) ;;
    *) rm -f "$tmp"; return 1 ;;
  esac
  if ! remote_version "$tmp" >/dev/null || ! bash -n "$tmp" 2>/dev/null; then
    rm -f "$tmp"; return 1
  fi
  printf '%s\n' "$tmp"
}

install_update() {
  local tmp="$1" self="$2"
  chmod 755 "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$self" 2>/dev/null || { rm -f "$tmp"; return 1; }
}

stamp_update_check() {
  mkdir -p "$CAROUSEL_HOME" 2>/dev/null || return 0
  date +%s > "$UPDATE_STAMP" 2>/dev/null || true
}

update_check_due() {
  case "$UPDATE_INTERVAL" in
    ''|*[!0-9]*) return 1 ;;   # unparseable interval: don't check at all
    0)           return 1 ;;
  esac
  [ -f "$UPDATE_STAMP" ] || return 0
  local last now
  last=$(tr -cd '0-9' < "$UPDATE_STAMP" 2>/dev/null)
  [ -n "$last" ] || return 0
  now=$(date +%s)
  [ $((now - last)) -ge "$UPDATE_INTERVAL" ]
}

maybe_self_update() {
  # Called only on the run/go paths, and only with a terminal attached, so that
  # `carousel -p ...` in a script or in CI never pays for it.
  [ -t 2 ] || return 0
  update_check_due || return 0
  local self; self=$(self_path)
  [ -n "$(update_blocked_reason "$self")" ] && return 0

  stamp_update_check
  local tmp; tmp=$(fetch_update "$self") || return 0
  [ -n "$tmp" ] || return 0

  local new old; new=$(remote_version "$tmp"); old="$VERSION"
  if ! version_gt "$new" "$old"; then rm -f "$tmp"; return 0; fi
  install_update "$tmp" "$self" || return 0

  printf '%s✓%s carousel updated %s → %s\n' "$C_G" "$C_0" "$old" "$new" >&2
  CAROUSEL_UPDATED=1 exec "$self" "$@"
}

cmd_update() {
  local self; self=$(self_path)
  local reason; reason=$(update_blocked_reason "$self")
  [ -n "$reason" ] && die "can't self-update: $reason"

  printf 'checking %s\n' "$UPDATE_URL"
  stamp_update_check
  local tmp CAROUSEL_UPDATE_TIMEOUT=10
  tmp=$(fetch_update "$self")
  [ -n "$tmp" ] || die "could not fetch a usable script from $UPDATE_URL"

  local new; new=$(remote_version "$tmp")
  if ! version_gt "$new" "$VERSION"; then
    rm -f "$tmp"
    printf '%s✓%s already up to date (%s)\n' "$C_G" "$C_0" "$VERSION"
    return 0
  fi
  install_update "$tmp" "$self" || die "could not write $self"
  printf '%s✓%s carousel updated %s → %s\n' "$C_G" "$C_0" "$VERSION" "$new"
}

# --- subcommands -------------------------------------------------------------
cmd_add() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: carousel add <name>"
  [ "$name" = "default" ] && die "'default' is reserved for your existing ~/.claude"
  case "$name" in
    .*|*/*) die "profile name can't start with '.' or contain '/'" ;;
    -*)     die "profile name can't start with '-' (those are forwarded to claude)" ;;
  esac
  is_reserved "$name" && die "'$name' is a reserved command name, pick another"

  local dir="$PROFILE_ROOT/$name"
  [ -d "$dir" ] && die "profile '$name' already exists"

  mkdir -p "$dir"
  sync_profile "$name"
  seed_local_files "$name"
  printf '%s✓%s profile %s%s%s created: %s\n' "$C_G" "$C_0" "$C_B" "$name" "$C_0" "$dir"
  printf '\nNext: %scarousel login %s%s\n' "$C_B" "$name" "$C_0"
}

cmd_login() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: carousel login <name>"
  profile_exists "$name" || die "profile '$name' does not exist. Run: carousel add $name"
  sync_profile "$name"
  printf 'Opening Claude Code for profile %s%s%s. Follow the login flow if prompted.\n' "$C_B" "$name" "$C_0"
  if [ "$name" = "default" ]; then
    exec env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN"
  else
    CLAUDE_CONFIG_DIR="$(profile_dir "$name")" exec "$CLAUDE_BIN"
  fi
}

has_permission_flag() {
  local a
  for a in "$@"; do
    case "$a" in
      --dangerously-skip-permissions|--permission-mode|--permission-mode=*|--allow-dangerously-skip-permissions)
        return 0 ;;
    esac
  done
  return 1
}

cmd_run() {
  # A first argument that looks like a flag is always meant for Claude Code,
  # with no exceptions: "carousel --resume" runs the default profile and
  # forwards --resume, and "carousel --help" reaches claude's help. carousel's
  # own commands are plain words ("carousel help", "carousel version"), so the
  # two sets can never collide. "--" is accepted as the usual explicit form.
  local name
  case "${1:-}" in
    --)    shift; name=$(get_default) ;;
    ""|-*) name=$(get_default) ;;
    *)     name="$1"; shift ;;
  esac
  profile_exists "$name" || die "profile '$name' does not exist. See: carousel ls"
  sync_profile "$name"

  local extra=""
  if [ "$BYPASS" = "1" ] && ! has_permission_flag "$@"; then
    extra="--dangerously-skip-permissions"
  fi

  if [ "$name" = "default" ]; then
    # shellcheck disable=SC2086
    exec env -u CLAUDE_CONFIG_DIR "$CLAUDE_BIN" $extra "$@"
  else
    # shellcheck disable=SC2086
    CLAUDE_CONFIG_DIR="$(profile_dir "$name")" exec "$CLAUDE_BIN" $extra "$@"
  fi
}

cmd_ls() {
  local def; def=$(get_default)
  printf '%s  %-14s %-30s %s\n' " " "PROFILE" "ACCOUNT" "CLAUDE_CONFIG_DIR"
  printf '%s  %-14s %-30s %s\n' " " "--------------" "------------------------------" "------------------"
  local name dir email label
  list_profiles | while IFS= read -r name; do
    dir=$(profile_dir "$name")
    email=$(profile_email "$dir")
    label="$name"
    [ "$name" = "$def" ] && label="$name *"
    printf '   %-14s %-30s %s\n' "$label" "$email" "$dir"
  done
  printf '\n%s*%s = default profile (used when you run "carousel" with no name)\n' "$C_Y" "$C_0"
}

cmd_use() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: carousel use <name>"
  profile_exists "$name" || die "profile '$name' does not exist"
  mkdir -p "$CAROUSEL_HOME"
  printf '%s\n' "$name" > "$DEFAULT_FILE"
  printf '%s✓%s default profile set to %s%s%s\n' "$C_G" "$C_0" "$C_B" "$name" "$C_0"
}

cmd_whoami() {
  local dir="${CLAUDE_CONFIG_DIR:-$DEFAULT_DIR}" name="" p pd
  list_profiles | while IFS= read -r p; do
    pd=$(profile_dir "$p")
    if [ "$(abspath "$pd")" = "$(abspath "$dir")" ]; then
      printf 'profile: %s\n' "$p"
      printf 'path   : %s\n' "$dir"
      printf 'account: %s\n' "$(profile_email "$pd")"
      return
    fi
  done
}

cmd_sync() {
  local name="${1:-}"
  if [ -n "$name" ]; then
    sync_profile "$name"
    printf '%s✓%s %s\n' "$C_G" "$C_0" "$name"
  else
    list_profiles | while IFS= read -r name; do
      [ "$name" = "default" ] && continue
      sync_profile "$name"
      printf '%s✓%s %s\n' "$C_G" "$C_0" "$name"
    done
  fi
}

cmd_rm() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: carousel rm <name>"
  [ "$name" = "default" ] && die "'default' points at your real ~/.claude — nothing to remove"
  local dir="$PROFILE_ROOT/$name"
  [ -d "$dir" ] || die "profile '$name' does not exist"
  printf 'Removing: %s\n' "$dir"
  printf '%s(only the symlinks are unlinked — your real plugins, projects and settings are untouched)%s\n' "$C_D" "$C_0"
  printf 'Proceed? [y/N] '
  read -r ans
  case "$ans" in y|Y|yes|YES) ;; *) printf 'cancelled\n'; return;; esac
  local item
  for item in $SHARED_DIRS $SHARED_FILES; do [ -L "$dir/$item" ] && rm -f "$dir/$item"; done
  rm -rf "$dir"
  printf '%s✓%s removed\n' "$C_G" "$C_0"
}

cmd_order() {
  if [ "$#" -eq 0 ]; then
    printf 'rotation order used by "carousel go":\n'
    get_order | nl -ba -w2 -s'. '
    return
  fi
  mkdir -p "$CAROUSEL_HOME"
  : > "$ORDER_FILE"
  local n
  for n in "$@"; do
    profile_exists "$n" || die "profile '$n' does not exist"
    printf '%s\n' "$n" >> "$ORDER_FILE"
  done
  printf '%s✓%s rotation order set: %s\n' "$C_G" "$C_0" "$*"
}

# --- rotation-aware run ("go") ------------------------------------------------
# Rotation hangs off Claude Code's own StopFailure hook, which fires when a turn
# ends on an API error and names the error. It replaced grepping a pty capture
# of the screen after claude exited, which could never work: the interactive UI
# doesn't exit on a usage limit — it sits there offering to wait for the reset —
# so the check only ran once you quit by hand, and by then the wording it looked
# for ("usage limit", "limit will reset") had become "You've hit your session
# limit" anyway.
#
# The hook is registered for this run only, through --settings. It saves its
# input, which carries the session id, and stops claude. carousel then resumes
# that same conversation on the next profile, which works because projects/ —
# where transcripts live — is shared by every profile.

go_prepare() {
  local state="$1"
  cat > "$state/on-limit.sh" <<'EOF'
#!/bin/sh
# Run by Claude Code when a turn ends on a rate limit, with the hook input on
# stdin. Keep it for carousel, then stop the claude that ran us.
here=$(dirname "$0")
cat > "$here/limit.json"
kill -TERM "$(cat "$here/pid")" 2>/dev/null
EOF
  cat > "$state/settings.json" <<EOF
{"hooks":{"StopFailure":[{"matcher":"rate_limit","hooks":[{"type":"command","command":"/bin/sh '$state/on-limit.sh'"}]}]}}
EOF
}

run_watched() {
  # Runs claude in the foreground like cmd_run does, but through a shell that
  # records its own pid and then execs claude in its place, so the pid on file
  # is claude's and the hook knows what to stop.
  local name="$1" state="$2"; shift 2

  local extra=""
  if [ "$BYPASS" = "1" ] && ! has_permission_flag "$@"; then
    extra="--dangerously-skip-permissions"
  fi

  # shellcheck disable=SC2016
  local launch='echo $$ > "$0/pid"; exec "$@"'
  if [ "$name" = "default" ]; then
    # shellcheck disable=SC2086
    env -u CLAUDE_CONFIG_DIR sh -c "$launch" "$state" "$CLAUDE_BIN" $extra --settings "$state/settings.json" "$@"
  else
    # shellcheck disable=SC2086
    CLAUDE_CONFIG_DIR="$(profile_dir "$name")" sh -c "$launch" "$state" "$CLAUDE_BIN" $extra --settings "$state/settings.json" "$@"
  fi
}

json_field() {
  # prints a top-level string field of a JSON file, or nothing
  python3 -c '
import json, sys
try:
    v = json.load(open(sys.argv[1])).get(sys.argv[2])
except Exception:
    v = None
print(v if isinstance(v, str) else "")
' "$1" "$2" 2>/dev/null
}

cmd_go() {
  local order_list; order_list=$(get_order)
  [ -n "$order_list" ] || die "no profiles to rotate through. Run: carousel add <name>"

  local cur; cur=$(get_default)
  local -a order=()
  while IFS= read -r l; do order+=("$l"); done <<EOF
$order_list
EOF

  local n=${#order[@]}
  local start_idx=0 i
  for i in "${!order[@]}"; do
    [ "${order[$i]}" = "$cur" ] && { start_idx=$i; break; }
  done

  local state; state=$(mktemp -d "${TMPDIR:-/tmp}/carousel.XXXXXX") || die "could not create a temp directory"
  # shellcheck disable=SC2064
  trap "rm -rf '$state'" EXIT
  go_prepare "$state"

  local tries=0 sid why
  while [ "$tries" -lt "$n" ]; do
    local idx=$(( (start_idx + tries) % n ))
    local name="${order[$idx]}"
    if ! profile_exists "$name"; then tries=$((tries + 1)); continue; fi

    printf '%s▶ running as %s%s\n' "$C_B" "$name" "$C_0"
    sync_profile "$name"
    rm -f "$state/limit.json" "$state/pid"
    run_watched "$name" "$state" "$@"
    local exit_code=$?

    # No hook input means claude ended for any other reason, /exit included.
    [ -s "$state/limit.json" ] || return "$exit_code"

    sid=$(json_field "$state/limit.json" session_id)
    case "$sid" in *[!0-9a-fA-F-]*) sid="" ;; esac
    why=$(json_field "$state/limit.json" last_assistant_message | head -n 1)

    # Whatever the first launch was given — a prompt, --resume, --model — is
    # not repeated: the conversation is what carries over.
    if [ -n "$sid" ]; then set -- --resume "$sid"; else set -- --continue; fi
    [ -n "$RESUME_PROMPT" ] && set -- "$@" "$RESUME_PROMPT"

    tries=$((tries + 1))
    if [ "$tries" -ge "$n" ]; then
      printf '%s✗%s every profile in rotation has hit a limit\n' "$C_R" "$C_0" >&2
      [ -n "$sid" ] && printf '  pick the conversation up later with: carousel --resume %s\n' "$sid" >&2
      return 1
    fi
    local next="${order[$(( (start_idx + tries) % n ))]}"
    printf '%s⚠ %s: %s%s\n' "$C_Y" "$name" "${why:-rate limit}" "$C_0"
    printf '%s  switching to %s and resuming the conversation in 2s (Ctrl-C to stop)%s\n' "$C_Y" "$next" "$C_0"
    sleep 2
  done
}

# --- shell alias management --------------------------------------------------
detect_rc() {
  case "$(basename "${SHELL:-sh}")" in
    zsh)  printf '%s\n' "$HOME/.zshrc" ;;
    bash) if [ -f "$HOME/.bashrc" ]; then printf '%s\n' "$HOME/.bashrc"
          else printf '%s\n' "$HOME/.bash_profile"; fi ;;
    fish) printf '%s\n' "$HOME/.config/fish/config.fish" ;;
    *)    printf '%s\n' "$HOME/.profile" ;;
  esac
}

remove_managed_block() {
  local rc="$1" tmp
  [ -f "$rc" ] || return 0
  tmp="$(mktemp)"
  awk -v s="$BLOCK_START" -v e="$BLOCK_END" '
    $0 == s { skip = 1; next }
    $0 == e { skip = 0; next }
    skip != 1 { print }
  ' "$rc" > "$tmp" && cat "$tmp" > "$rc"
  rm -f "$tmp"
}

write_managed_block() {
  local rc="$1" name="$2"
  mkdir -p "$(dirname "$rc")"
  remove_managed_block "$rc"
  {
    printf '%s\n' "$BLOCK_START"
    printf "alias %s='carousel'\n" "$name"
    printf '%s\n' "$BLOCK_END"
  } >> "$rc"
}

# an `alias <name>=` line that we did not write ourselves
find_foreign_alias() {
  local name="$1" rc="$2"
  [ -f "$rc" ] || return 1
  awk -v s="$BLOCK_START" -v e="$BLOCK_END" -v n="$name" '
    $0 == s { skip = 1; next }
    $0 == e { skip = 0; next }
    skip == 1 { next }
    $0 ~ "^[[:space:]]*alias[[:space:]]+" n "=" { print NR ": " $0; found = 1 }
    END { exit(found ? 0 : 1) }
  ' "$rc"
}

comment_out_foreign_alias() {
  local name="$1" rc="$2" tmp
  tmp="$(mktemp)"
  awk -v s="$BLOCK_START" -v e="$BLOCK_END" -v n="$name" '
    $0 == s { inblock = 1; print; next }
    $0 == e { inblock = 0; print; next }
    inblock == 0 && $0 ~ "^[[:space:]]*alias[[:space:]]+" n "=" {
      print "# " $0 "  # disabled by claude-carousel"
      next
    }
    { print }
  ' "$rc" > "$tmp" && cat "$tmp" > "$rc"
  rm -f "$tmp"
}

cmd_alias() {
  local assume_yes=0 name=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -y|--yes)   assume_yes=1 ;;
      --remove)   name="--remove" ;;
      -*)         die "unknown option: $1" ;;
      *)          name="$1" ;;
    esac
    shift
  done

  local rc; rc="$(detect_rc)"

  # no argument: report what's registered
  if [ -z "$name" ]; then
    if [ -f "$ALIAS_FILE" ]; then
      printf 'alias    : %s -> carousel\n' "$(cat "$ALIAS_FILE")"
    else
      printf 'alias    : (none registered)\n'
    fi
    printf 'shell rc : %s\n' "$rc"
    printf '\nSet one with:  carousel alias <name>       (e.g. carousel alias cc)\nRemove it with: carousel alias --remove\n'
    return 0
  fi

  if [ "$name" = "--remove" ]; then
    remove_managed_block "$rc"
    rm -f "$ALIAS_FILE"
    printf '%s✓%s alias removed from %s (restart your shell to apply)\n' "$C_G" "$C_0" "$rc"
    return 0
  fi

  case "$name" in
    *[!a-zA-Z0-9_-]*) die "'$name' isn't a usable alias name (letters, digits, _ and - only)" ;;
  esac
  [ "$name" = "carousel" ] && die "that's already the command name"

  # conflict 1: an alias someone else defined in the rc
  local foreign; foreign="$(find_foreign_alias "$name" "$rc" 2>/dev/null || true)"
  if [ -n "$foreign" ]; then
    printf '%s!%s %s already has an alias named "%s":\n' "$C_Y" "$C_0" "$rc" "$name"
    printf '    %s\n' "$foreign"
    if [ "$assume_yes" = "1" ]; then
      comment_out_foreign_alias "$name" "$rc"
      printf '%s✓%s commented the old line out\n' "$C_G" "$C_0"
    else
      printf 'Comment it out and take over "%s"? [y/N] ' "$name"
      local ans; ans="$(prompt_read)"
      case "$ans" in
        y|Y|yes|YES) comment_out_foreign_alias "$name" "$rc"
                     printf '%s✓%s commented the old line out\n' "$C_G" "$C_0" ;;
        *)           printf 'Left it alone — pick another name and run: carousel alias <name>\n'
                     return 1 ;;
      esac
    fi
  fi

  # conflict 2: a real binary of the same name (cc, ls, ...)
  local existing; existing="$(command -v "$name" 2>/dev/null || true)"
  case "$existing" in
    ""|*"alias"*) ;;
    *) printf '%s!%s "%s" is also a real command at %s.\n' "$C_Y" "$C_0" "$name" "$existing"
       printf '  A shell alias only shadows it when you type it interactively —\n'
       printf '  scripts and Makefiles calling %s keep using %s.\n' "$name" "$existing" ;;
  esac

  write_managed_block "$rc" "$name"
  mkdir -p "$CAROUSEL_HOME"
  printf '%s\n' "$name" > "$ALIAS_FILE"
  printf '%s✓%s "%s" now runs carousel (added to %s)\n' "$C_G" "$C_0" "$name" "$rc"
  printf '  Apply it now with:  source %s\n' "$rc"
}

# --- star the repo (explicit opt-in only) ------------------------------------
cmd_star() {
  command -v gh >/dev/null 2>&1 || {
    printf 'The GitHub CLI (gh) is not installed. You can star it in a browser instead:\n'
    printf '  https://github.com/%s\n' "$REPO_SLUG"
    return 1
  }
  gh auth status >/dev/null 2>&1 || {
    printf 'gh is installed but not logged in. Run "gh auth login" first, or star it here:\n'
    printf '  https://github.com/%s\n' "$REPO_SLUG"
    return 1
  }
  if gh api -X PUT "user/starred/$REPO_SLUG" >/dev/null 2>&1; then
    printf '%s★%s thanks! starred %s\n' "$C_Y" "$C_0" "$REPO_SLUG"
  else
    printf 'Could not star it automatically. Here it is in a browser:\n'
    printf '  https://github.com/%s\n' "$REPO_SLUG"
    return 1
  fi
}

cmd_doctor() {
  printf 'carousel      : %s\n' "$VERSION"
  printf 'OS            : %s\n' "$OS"
  printf 'shell         : %s\n' "${BASH_VERSION:+bash $BASH_VERSION}"
  printf 'claude binary : %s\n' "$(command -v "$CLAUDE_BIN" 2>/dev/null || echo 'NOT FOUND on PATH')"
  if [ -n "$RESUME_PROMPT" ]; then
    printf 'go resumes    : by sending "%s" (CAROUSEL_RESUME_PROMPT= to wait at the prompt)\n' "$RESUME_PROMPT"
  else
    printf 'go resumes    : at the prompt, sending nothing\n'
  fi
  case "$OS" in
    Darwin) printf 'credentials   : macOS Keychain, per CLAUDE_CONFIG_DIR (handled automatically)\n' ;;
    *)      printf 'credentials   : a local file under each profile'\''s CLAUDE_CONFIG_DIR (handled automatically by Claude Code itself)\n' ;;
  esac
  printf 'carousel home : %s\n' "$CAROUSEL_HOME"
  printf 'shared assets : symlinked to %s (%s %s)\n' "$DEFAULT_DIR" "$SHARED_DIRS" "$SHARED_FILES"
  printf 'per-profile   : %s\n' "$LOCAL_FILES"
  printf 'bypass mode   : %s (--dangerously-skip-permissions; set CAROUSEL_BYPASS=0 to turn off)\n' "$([ "$BYPASS" = "1" ] && echo on || echo off)"
  local self blocked; self=$(self_path); blocked=$(update_blocked_reason "$self")
  printf 'script path   : %s\n' "$self"
  printf 'auto-update   : %s\n' "${blocked:-on (checks every ${UPDATE_INTERVAL}s; set CAROUSEL_NO_UPDATE=1 to turn off)}"
}

usage_row() {
  # $1 command, $2 column width, $3 description
  printf '  %s%-*s%s %s\n' "$C_B" "$2" "$1" "$C_0" "$3"
}

usage() {
  # show the alias the user actually registered, so the help matches what they type
  local me="carousel"
  if [ -f "$ALIAS_FILE" ]; then
    me="$(cat "$ALIAS_FILE" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$me" ] || me="carousel"
  fi
  local w=$(( ${#me} + 18 ))

  printf '%sclaude-carousel%s — switch between multiple Claude Code accounts\n\n' "$C_B" "$C_0"
  usage_row "$me ls"              "$w" "list profiles"
  usage_row "$me add <name>"      "$w" "create a new profile"
  usage_row "$me login <name>"    "$w" "log in to a profile (first-time setup)"
  usage_row "$me <name> [args...]" "$w" "run Claude Code as that profile"
  usage_row "$me"                 "$w" "run the default profile"
  usage_row "$me [claude args...]" "$w" "ditto — every -flag goes to claude"
  usage_row "$me use <name>"      "$w" "set the default profile"
  usage_row "$me whoami"          "$w" "show which profile the current shell is in"
  usage_row "$me order [names...]" "$w" "view/set the rotation order for \"go\""
  usage_row "$me go [args...]"     "$w" "run, and on a usage limit resume the same"
  usage_row ""                    "$w" "conversation on the next profile"
  usage_row "$me sync [name]"     "$w" "re-link shared plugins/settings to ~/.claude"
  usage_row "$me rm <name>"       "$w" "remove a profile"
  usage_row "$me alias [name]"    "$w" "register/change a short shell alias (--remove to undo)"
  usage_row "$me star"            "$w" "star the repo, if you find this useful"
  usage_row "$me update"          "$w" "update carousel now (it also self-updates daily)"
  usage_row "$me doctor"          "$w" "environment / troubleshooting info"
  usage_row "$me help"            "$w" "this help"
  usage_row "$me version"         "$w" "print the version"


  if [ "$me" = "carousel" ]; then
    printf '\nTyping "carousel" gets old — "carousel alias cc" makes "cc go" work.\n'
  fi

  cat <<EOF

Every carousel command above is a plain word, so anything starting with "-" is
forwarded to Claude Code untouched — "$me --resume", "$me --help", "$me -p ...".
carousel's own help and version are "$me help" and "$me version".

Your existing Claude Code login is always available as the "default" profile —
nothing to migrate, no re-login needed for the account you already use.

Bypass mode (--dangerously-skip-permissions) is ON by default. Turn it off with:
  export CAROUSEL_BYPASS=0

carousel checks for a new version once a day when it launches Claude Code, and
updates itself in place. Turn that off with:
  export CAROUSEL_NO_UPDATE=1
EOF
}

# Only the paths that actually launch Claude Code pay for an update check —
# and only once a day. Everything else dispatches straight through.
case "${1:-}" in
  ls|list|add|login|use|switch|whoami|who|sync|rm|remove|order|doctor|alias|star|update|version|help) ;;
  *) maybe_self_update "$@" ;;
esac

case "${1:-}" in
  ls|list)      shift; cmd_ls "$@" ;;
  add)          shift; cmd_add "$@" ;;
  login)        shift; cmd_login "$@" ;;
  use|switch)   shift; cmd_use "$@" ;;
  whoami|who)   shift; cmd_whoami "$@" ;;
  sync)         shift; cmd_sync "$@" ;;
  rm|remove)    shift; cmd_rm "$@" ;;
  order)        shift; cmd_order "$@" ;;
  go)           shift; cmd_go "$@" ;;
  doctor)       shift; cmd_doctor "$@" ;;
  version)      printf 'claude-carousel %s\n' "$VERSION" ;;
  alias)        shift; cmd_alias "$@" ;;
  update)       shift; cmd_update "$@" ;;
  star)         shift; cmd_star "$@" ;;
  help)         usage ;;
  *)            cmd_run "$@" ;;
esac
